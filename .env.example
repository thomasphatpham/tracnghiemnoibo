# Application Ports
PORT=4000
FRONTEND_PORT=3000
FRONTEND_URL=http://localhost:3000

# Database (PostgreSQL via Prisma)
# Khi chạy qua Docker Compose mặc định port 5432:
# DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/trac_nghiem?schema=public"
# Khi chạy với PostgreSQL local port 5433:
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/trac_nghiem?schema=public"

# JWT Authentication
JWT_SECRET=super-secret-jwt-key-change-in-production-tracnghiemnoibo-2026
JWT_EXPIRES_IN=1d

# SMTP Configuration (Nodemailer)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Hệ Thống Thi Trắc Nghiệm <no-reply@tracnghiem.local>"

# Security & Business Policies
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
OTP_EXPIRES_MINUTES=10
OTP_MAX_ATTEMPTS=3
