# Application Ports
PORT=4000
FRONTEND_PORT=3000
FRONTEND_URL=http://localhost:3000

# Database (PostgreSQL)
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public
# Mặc định khi chạy qua Docker Compose:
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/trac_nghiem?schema=public"

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-replace-in-production
JWT_EXPIRES_IN=1d

# SMTP Configuration (Gửi email OTP / cấp tài khoản)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Hệ Thống Thi Trắc Nghiệm <no-reply@tracnghiem.local>"

# Security Policies
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
OTP_EXPIRES_MINUTES=10
OTP_MAX_ATTEMPTS=3
